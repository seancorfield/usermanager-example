{:mvn/repos {"ossrh-snapshots" {:url "https://s01.oss.sonatype.org/content/repositories/snapshots"}}
 :paths ["resources" "src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.2"}

        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1070"}
        com.xtdb/xtdb-api {:mvn/version "2.0.0"}
        com.stuartsierra/component {:mvn/version "1.1.0"}

        compojure/compojure {:mvn/version "1.7.1"}
        ring/ring {:mvn/version "1.14.2"}
        ring/ring-defaults {:mvn/version "0.6.0"}

        selmer/selmer {:mvn/version "1.12.62"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps
         {com.xtdb/xtdb-core {:mvn/version "2.0.0"}
          io.github.cognitect-labs/test-runner
          {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         ;; in-process: needed on JDK17+
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "-Dio.netty.tryReflectionSetAccessible=true"]}
  :build {:replace-deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
          :ns-default build}}}
